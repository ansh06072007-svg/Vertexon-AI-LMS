# Local development defaults. Copy to .env only if you need overrides.
# The API reads these values from the process environment.
PORT=5174
HOST=127.0.0.1

# Change these before exposing the app outside localhost.
JWT_ACCESS_SECRET=vertexon-dev-access-secret-change-me
JWT_REFRESH_SECRET=vertexon-dev-refresh-secret-change-me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
JWT_REFRESH_DAYS=7
