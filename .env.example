# Local development defaults. `npm run dev` and `npm start` load this file
# automatically when it exists. On Render, set the same values in the dashboard.
PORT=5174
HOST=127.0.0.1

# Change these before exposing the app outside localhost.
JWT_ACCESS_SECRET=vertexon-dev-access-secret-change-me
JWT_REFRESH_SECRET=vertexon-dev-refresh-secret-change-me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
JWT_REFRESH_DAYS=7

# Optional storage overrides. On Render, point these at a persistent disk.
# DB_PATH=/var/data/vertexon.db
# UPLOAD_DIR=/var/data/uploads
# MAIL_OUTBOX_LOG=/var/data/mail-outbox.log

# There is no AI provider key. The tutor uses local retrieval in server/ai.mjs.
